  "firestore": {
    "/schools/{schoolId}": {
      "schema": {
        "$ref": "#/entities/SchoolConfig"
      },
      "description": "Dokumen konfigurasi utama workspace sekolah per pemilik Google Auth UID."
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/StudentRecord"
      },
      "description": "Subkoleksi daftar siswa sekolah (mengandung PII no_wa_ortu)."
    },
    "/schools/{schoolId}/attendance/{recordId}": {
      "schema": {
        "$ref": "#/entities/AttendanceRecord"
      },
      "description": "Subkoleksi catatan presensi harian siswa termasuk alasan pulang cepat."
    },
    "/schools/{schoolId}/subjects/{subjectId}": {
      "schema": {
        "$ref": "#/entities/MasterSubject"
      },
      "description": "Subkoleksi master mata pelajaran sekolah."
    },
    "/schools/{schoolId}/schedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/TeacherSchedule"
      },
      "description": "Subkoleksi jadwal pelajaran guru."
    },
    "/schools/{schoolId}/subjectAssignments/{assignmentId}": {
      "schema": {
        "$ref": "#/entities/SubjectAssignment"
      },
      "description": "Subkoleksi penugasan kelas dan mata pelajaran guru."
    },
    "/schools/{schoolId}/subjectRecords/{recordId}": {
      "schema": {
        "$ref": "#/entities/SubjectAttendanceRecord"
      },
      "description": "Subkoleksi catatan presensi kehadiran mata pelajaran siswa."
    },
    "/schools/{schoolId}/accounts/{accountId}": {
      "schema": {
        "$ref": "#/entities/AppUserAccount"
      },
      "description": "Subkoleksi akun peran internal aplikasi sekolah."
    },
    "/schools/{schoolId}/lateCorrectionRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/LateCorrectionRequest"
      },
      "description": "Subkoleksi permohonan ubah kehadiran tepat waktu dari Wali Kelas ke Master Admin."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Dokumen peran admin tingkat platform."
    }
  }
}
