{
  "entities": {
    "SchoolConfig": {
      "title": "SchoolConfig",
      "description": "Konfigurasi profil sekolah, pengesahan E-Card, jadwal presensi, tahun ajaran, dan tema aplikasi untuk sinkronisasi lintas perangkat.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "nama_sekolah": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nama_kepala_sekolah": {
          "type": "string",
          "maxLength": 160
        },
        "nip_kepala_sekolah": {
          "type": "string",
          "maxLength": 64
        },
        "ttd_kepala_sekolah": {
          "type": "string",
          "maxLength": 150000
        },
        "cap_sekolah": {
          "type": "string",
          "maxLength": 150000
        },
        "logo_sekolah": {
          "type": "string",
          "maxLength": 150000
        },
        "batas_jam_masuk": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "maxLength": 5
        },
        "mode_presensi": {
          "type": "string",
          "enum": ["masuk_saja", "masuk_pulang"]
        },
        "jam_pulang_standar": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "maxLength": 5
        },
        "tahun_ajaran": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "semester": {
          "type": "string",
          "enum": ["ganjil", "genap"]
        },
        "tema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "script_url": {
          "type": "string",
          "maxLength": 500
        },
        "no_wa_admin": {
          "type": "string",
          "maxLength": 32
        },
        "show_creator_credit": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "nama_sekolah",
        "nama_kepala_sekolah",
        "nip_kepala_sekolah",
        "ttd_kepala_sekolah",
        "cap_sekolah",
        "logo_sekolah",
        "batas_jam_masuk",
        "mode_presensi",
        "jam_pulang_standar",
        "tahun_ajaran",
        "semester",
        "tema",
        "script_url",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Data induk siswa termasuk nomor WhatsApp orang tua (PII terbatas pemilik sekolah).",
